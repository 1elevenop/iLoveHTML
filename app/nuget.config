<?xml version="1.0" encoding="utf-8"?>
<!-- local_auth_windows downloads two NuGet packages while building the Windows
     app; this makes sure nuget.org is a source even when the machine's NuGet
     config lists none. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
